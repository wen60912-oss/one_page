
---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "本吉·泰勒",
  description = "个人主页与文章",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: #fff;
    color: #171717;
    font-family:
      Arial,
      "Helvetica Neue",
      "Noto Sans SC",
      "Microsoft YaHei",
      sans-serif;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    min-width: 320px;
    background: #fff;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
  }

  ::selection {
    color: #fff;
    background: #222;
  }
</style>
