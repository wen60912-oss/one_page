<button id="menu-button" aria-label="打开菜单">
  ☰
</button>

<nav id="menu">
  <a href="/">首页</a>
  <a href="/blog">文章</a>
  <a href="/projects">项目</a>
  <a href="/about">关于我</a>
</nav>

<style>
  button {
    font-size: 28px;
    background: none;
    border: none;
    cursor: pointer;
  }

  nav {
    display: none;
    position: absolute;
    right: 20px;
    top: 60px;
    background: white;
    padding: 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,.15);
  }

  nav.open {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  a {
    text-decoration: none;
    color: #333;
  }
</style>

<script>
  const button = document.querySelector('#menu-button');
  const menu = document.querySelector('#menu');

  button?.addEventListener('click', () => {
    menu?.classList.toggle('open');
  });
</script>
